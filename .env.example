# Copy to .env and fill in to enable the optional Groq LLM extractor.
# Without this file the app still runs fully on the offline heuristic extractor.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model. gpt-oss is the free-tier model.
GROQ_MODEL=openai/gpt-oss-120b

# Where SQLite lives (optional)
KB_DB=backend/knowledge.db
